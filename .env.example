# ============================================================
# ZooTech Backend - Variables
# Estas variables seran pasadas al appSettings.json del
# Backend .NET Core 10 dentro del contenedor zootech-app-backend
# Algunas variables son usadas por otros contenedores
# como zootech-sql-init o zootech-sql-seeder
# ============================================================

ASPNETCORE_ENVIRONMENT=Development

CONNECTION_STRING_TENANT_TEMPLATE=Server=zootech-db-sqlserver,1433;TrustServerCertificate=True;User Id=zootech-db-user;Password=My_D4t4ba5E_2o26_Z00T3cH_9090_1901;MultipleActiveResultSets=true;Pooling=True
CONNECTION_STRING_ADMIN_TENANT_TEMPLATE=Server=zootech-db-sqlserver,1433;TrustServerCertificate=True;User Id=zootech-db-user;Password=My_D4t4ba5E_2o26_Z00T3cH_9090_1901;MultipleActiveResultSets=true

BACKEND_URL=http://*:16001

MULTITENANT_BASE_DOMAIN=zentrycorp.local
MULTITENANT_ADMIN_SUB_DOMAIN=soporte
MULTITENANT_ADMIN_DATABASE_NAME=ZooTech_CentroSoporte_Db

MONGODB_CONNECTION_STRING=mongodb://zootech_audit_user:Zo0Tech_Aud1t_L0g_1323_0wo-L0c4l@zootech-db-mongodb:27017/zootech_audit?authSource=zootech_audit
MONGODB_DATABASE_NAME=zootech_audit
MONGODB_ERROR_LOGS_COLLECTION_NAME=application_error_logs
MONGODB_EVENT_LOGS_COLLECTION_NAME=application_event_logs

AUDITING_MAX_ARRAY_ITEMS=30
AUDITING_MAX_STRING_LENGTH=1500
AUDITING_MAX_DEPTH=4

GARNET_CONNECTION_STRING=zootech-garnet:6379
GARNET_EXPIRATION_TIME=05:30

JWT_ISSUER=Zootech
JWT_AUDIENCE=Zootech.Client
JWT_SECRET_KEY=azDaSjV5wT7hvqbFFPCD2UiTcJXzxzAGKu9R
JWT_EXPIRATION_MINUTES=120

# ################################################################################
# ################################################################################

# ============================================================
# ZooTech DB SQL Server - Variables
# Veriables que se pasaran al contendor SQL Server 2025
# zootech-db-sqlserver
# ============================================================

MSSQL_SA_PASSWORD=Main_user-password_sql_server123

# ################################################################################
# ################################################################################

# ============================================================
# ZooTech MongoDB - Variables
# Veriables que se pasaran al contendor MongoDB 8.3
# zootech-db-mongodb
# ============================================================

MONGODB_INITDB_ROOT_USERNAME=admin
MONGODB_INITDB_ROOT_PASSWORD=Fi55_Systems_admin
MONGODB_INITDB_DATABASE=base_db

MONGODB_APP_USER=zootech_audit_user
MONGODB_APP_PASSWORD=Zo0Tech_Aud1t_L0g_1323_0wo-L0c4l

# El valor por defecto es de una hora
MONGODB_DELETE_LOGS_AFTER_SECONDS=3600
MONGODB_MODEL_FIELDNAME_WITH_TIMESTAMP_VALUE=registered_at

# ################################################################################
# ################################################################################

# ============================================================
# ZooTech - Compose Container Names - Variables
# Veriables que se pasan a determinados contenedores para
# estandarizar las conexiones entre contenedores
# ej: El comando de conexion usado por el script init dentro del
# contenedor zootech-sql-init se refiere a esta variable varias veces
# ============================================================
ZOOTECH_DB_SQLSERVER_CONTAINER_NAME=zootech-db-sqlserver

# ################################################################################
# ################################################################################

# ============================================================
# ZooTech - SQL Init - Variables
# Variables que se pasan al contenedor zootech-sql-init
# ============================================================

# Colorar "false" para crear unicamente la base de datos admin
# el usuario admin inicial e insertar los parametros en la 
# BD Admin. Omitiendo los BD Tenants
ZOOTECH_SQL_TENANTS_INIT_EXECUTE=true

# Este mismo nombre de usuario de BD debe configurarse
# en la cadena de conexion 
# CONNECTION_STRING_TENANT_TEMPLATE
# CONNECTION_STRING_ADMIN_TENANT_TEMPLATE
ZOOTECH_DB_USER=zootech-db-user
ZOOTECH_DB_USER_PASSWORD=My_D4t4ba5E_2o26_Z00T3cH_9090_1901

# Estos nombres de aqui deben estar tambien definidos en el script
# del backend 04-insert-tenants-info.sql
ZOOTECH_TENANT_DB_NAME_1=ZooTech_GanaderaAltoHuallaga_Db
ZOOTECH_TENANT_DB_NAME_2=ZooTech_AgropecuariaMonzon_Db
ZOOTECH_TENANT_DB_NAME_3=ZooTech_FundoRioVerde_Db

# Usuario: admin@zootech.com
# Contraseña real: ZooTech@2026
APP_ADMIN_USER_TEST_PASSWORD_HASH=AQAAAAIAAYagAAAAEMm2TFxlhtMFatIefZVgdd3SS39d3l80moLqhMlBFbNI9tLW0K1PtRLO9uMX2gLOxg==

# Variables con informacion para crear Admin Tenant
ZOOTECH_ADMIN_TENANT_CODE=CENTRO_SOPORTE_ZOOTECH
ZOOTECH_ADMIN_TENANT_DISPLAY_NAME="Centro Soporte ZooTech"
ZOOTECH_ADMIN_TENANT_LEGAL_NAME="Centro Soporte ZooTech S.A.C."
ZOOTECH_ADMIN_TENANT_EMAIL=soporte@zootech.com
ZOOTECH_ADMIN_TENANT_TIMEZONE=America/Lima
# Solo toma ACTIVE o INACTIVE
ZOOTECH_ADMIN_TENANT_STATUS=ACTIVE

# ################################################################################
# ################################################################################

